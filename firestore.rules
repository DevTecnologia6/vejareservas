rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Funções =================

    // PROPRIETÁRIO: e-mail na lista E e-mail confirmado
    // 1ª etapa: e-mail do dono confirmado (aparelho autorizado pelo link do e-mail)
    function emailDono() {
      return request.auth != null
        && request.auth.token.email in ['devtecnologia6@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function idSessao() { return request.auth.uid + '_' + string(request.auth.token.auth_time); }
    // 2ª etapa: senha do painel conferida nesta sessão
    function isDono() {
      return emailDono() && exists(/databases/$(database)/documents/acessoAdmin/$(idSessao()));
    }
    function logado()          { return request.auth != null; }
    function emailConfirmado() { return logado() && request.auth.token.email_verified == true; }
    function solDoc(id)        { return get(/databases/$(database)/documents/solicitacoes/$(id)).data; }
    function reservaDoc(id)    { return get(/databases/$(database)/documents/reservas/$(id)).data; }
    function infoPublica()     { return get(/databases/$(database)/documents/publico/info).data; }
    // conta excluída/bloqueada pelo dono
    function bloqueado() {
      return exists(/databases/$(database)/documents/bloqueados/$(request.auth.uid))
        || exists(/databases/$(database)/documents/bloqueiosEmail/$(request.auth.token.email.lower()));
    }
    function clienteAtivo() { return emailConfirmado() && !bloqueado(); }
    function clienteOk()    { return isDono() || clienteAtivo(); }
    function agora()        { return request.time.toMillis(); }
    function dataValida(s)  { return s is string && s.matches('^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function diaTs(s)       { return timestamp.date(int(s.split('-')[0]), int(s.split('-')[1]), int(s.split('-')[2])); }
    // ---- formato da locação (mesmas contas de js/calendar.js) ----
    function ehMeia(x)   { return x.get('meia', false) == true; }
    function horasF(x)   { return (x.get('dias', 1) > 1 ? 24 * x.get('dias', 1) : (x.periodo == '12h' ? 12 : 24)) + (ehMeia(x) ? 12 : 0); }
    function contaF(x)   { return x.get('dias', 1) + (ehMeia(x) ? 1 : 0); }   // quantas datas ocupa
    function precoF(info, x) {
      return (x.get('dias', 1) > 1 ? info.preco24 * x.get('dias', 1) : (x.periodo == '12h' ? info.preco12 : info.preco24)) + (ehMeia(x) ? info.preco12 : 0);
    }
    // "AAAA-MM-DD" + "HH:MM" (horário de Brasília, UTC-3) → milissegundos
    function msDe(data, hora) {
      return (diaTs(data) + duration.value(int(hora.split(':')[0]) * 60 + int(hora.split(':')[1]) + 180, 'm')).toMillis();
    }
    // a data está dentro das datas que a pré-reserva pode segurar? (na extensão, só as datas novas)
    function dentroDaSol(dia, s) {
      return diaTs(dia) >= diaTs(s.get('marcaIni', s.data)) && diaTs(dia) < diaTs(s.data) + duration.value(contaF(s), 'd');
    }

    // ---- intervalo de limpeza entre locações (folga em ms) ----
    function ocupPath(dia) { return /databases/$(database)/documents/ocupacao/$(dia); }
    function ocupExpirada(o) { return o.get('status', '') == 'pendente' && o.get('expiraEm', 9999999999999) < agora(); }
    // a locação do dia anterior termina (com folga) antes desta começar?
    function antesOk(o, ini, folga)  { return ocupExpirada(o) || o.get('fim', 0) + folga <= ini; }
    function livreAntes(dia, ini, folga) { return !exists(ocupPath(dia)) || antesOk(get(ocupPath(dia)).data, ini, folga); }
    // a próxima locação começa (com folga) depois desta terminar?
    function depoisOk(o, fim, folga) { return ocupExpirada(o) || o.get('ini', 9999999999999) >= fim + folga; }
    function livreDepois(dia, fim, folga) { return !exists(ocupPath(dia)) || depoisOk(get(ocupPath(dia)).data, fim, folga); }

    // ================= Acesso em duas etapas do administrador =================
    // hash da senha do painel: ninguém lê; criado uma vez; trocado só com o painel destrancado
    match /segredoAdmin/{uid} {
      allow read, delete: if false;
      allow create: if emailDono() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hash'])
        && request.resource.data.hash is string && request.resource.data.hash.size() == 64;
      allow update: if isDono() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['hash'])
        && request.resource.data.hash is string && request.resource.data.hash.size() == 64;
    }
    // destrava a sessão atual somente se a senha conferir com o hash guardado
    match /acessoAdmin/{sid} {
      allow read: if false;
      allow create, update: if emailDono() && sid == idSessao()
        && request.resource.data.keys().hasOnly(['authTime', 'h', 'em'])
        && request.resource.data.authTime == request.auth.token.auth_time
        && request.resource.data.h is string && request.resource.data.h.size() == 64
        && hashing.sha256(request.resource.data.h.toUtf8()).toHexString().lower()
           == get(/databases/$(database)/documents/segredoAdmin/$(request.auth.uid)).data.hash;
      allow delete: if emailDono() && sid == idSessao();
    }

    // ================= Área do proprietário =================
    match /bloqueados/{uid}       { allow read, write: if isDono(); }
    match /bloqueiosEmail/{email} { allow read, write: if isDono(); }
    match /despesas/{id}          { allow read, write: if isDono(); }
    match /config/{id}            { allow read, write: if isDono(); }

    // Reservas: só o dono escreve; o cliente LÊ apenas as reservas ligadas à conta dele
    match /reservas/{id} {
      allow write: if isDono();
      allow read:  if isDono() || (logado() && resource.data.clienteUid == request.auth.uid);
    }

    // ================= Contas de clientes =================
    match /clientes/{uid} {
      allow read: if isDono() || (logado() && request.auth.uid == uid);
      allow create, update: if logado() && request.auth.uid == uid && !bloqueado()
        && request.resource.data.keys().hasOnly(['nome','telefone','cpf','end','endereco','email','criadoEm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 80
        && request.resource.data.telefone is string && request.resource.data.telefone.matches('^[0-9]{11}$')
        && (!('cpf' in request.resource.data) || (request.resource.data.cpf is string && request.resource.data.cpf.matches('^[0-9]{11}$')))
        && (!('endereco' in request.resource.data) || (request.resource.data.endereco is string && request.resource.data.endereco.size() <= 200))
        && (!('end' in request.resource.data) || request.resource.data.end is map)
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      allow delete: if isDono();
    }

    // ================= Conteúdo da área do cliente (só com conta confirmada) =================
    match /publico/{id}   { allow read: if clienteOk(); allow write: if isDono(); }
    match /fotos/{id}     { allow read: if clienteOk(); allow write: if isDono(); }
    match /fotosFull/{id} { allow read: if clienteOk(); allow write: if isDono(); }

    // ================= Datas ocupadas =================
    // O cliente só segura datas da PRÓPRIA pré-reserva, dentro das diárias dela e com o mesmo prazo de pagamento.
    function ocupacaoDoCliente(dia) {
      let novo = request.resource.data;
      let s = solDoc(novo.sol);
      return clienteAtivo()
        && dataValida(dia)
        && novo.keys().hasOnly(['status', 'expiraEm', 'sol', 'ini', 'fim'])
        && novo.status == 'pendente'
        && s.uid == request.auth.uid
        && s.status == 'aguardando'
        && dentroDaSol(dia, s)
        && novo.get('ini', 0) == s.get('ini', 0) && novo.get('fim', 0) == s.get('fim', 0)
        && (('expiraEm' in novo && (novo.expiraEm == s.expiraEm || novo.expiraEm <= agora()))   // prazo normal ou liberação
            || (!('expiraEm' in novo) && s.get('pagoInformadoEm', null) != null));            // "Já paguei"
    }
    match /ocupacao/{dia} {
      allow read: if clienteOk();
      allow create: if isDono() || ocupacaoDoCliente(dia);
      // atualizar só se a data for da própria pré-reserva ou se o prazo de pagamento de outra pessoa já expirou
      allow update: if isDono() || (
        ocupacaoDoCliente(dia)
        && resource.data.status == 'pendente'
        && (solDoc(resource.data.sol).uid == request.auth.uid
            || ('expiraEm' in resource.data && resource.data.expiraEm < agora()))
      );
      allow delete: if isDono();
    }

    // ================= Pedidos de cancelamento =================
    // Só para a PRÓPRIA reserva e DENTRO do prazo (7 dias após a confirmação)
    match /cancelamentos/{rid} {
      allow read: if isDono() || (logado() && resource.data.uid == request.auth.uid);
      allow update, delete: if isDono();
      allow create: if isDono() || (
        clienteAtivo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reservaId == rid
        && request.resource.data.status == 'pendente'
        && request.resource.data.keys().hasOnly(['uid','reservaId','cliente','data','motivo','status','criadoEm'])
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 300
        && reservaDoc(rid).clienteUid == request.auth.uid
        && agora() <= reservaDoc(rid).prazoCancelamento
      );
    }

    // ================= Uma pré-reserva aguardando pagamento por vez =================
    // preReservaAtiva/{uid} aponta para a última pré-reserva do cliente; é gravado junto com ela (mesmo lote).
    function semPendencia(solId) {
      let p = /databases/$(database)/documents/solicitacoes/$(solId);
      return !exists(p) || get(p).data.status != 'aguardando'
        || (get(p).data.get('pagoInformadoEm', null) == null && get(p).data.expiraEm < agora());
    }
    match /preReservaAtiva/{uid} {
      allow read: if isDono() || (logado() && request.auth.uid == uid);
      allow delete: if isDono();
      allow update: if isDono() || (clienteAtivo() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sol'])
        && getAfter(/databases/$(database)/documents/solicitacoes/$(request.resource.data.sol)).data.uid == uid
        && semPendencia(resource.data.sol));
      allow create: if isDono() || (clienteAtivo() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['sol'])
        && getAfter(/databases/$(database)/documents/solicitacoes/$(request.resource.data.sol)).data.uid == uid);
    }

    // ================= Pré-reservas =================
    function sinalOk(d, info) {
      return (d.sinal == 0 && info.get('pix', null) == null)
        || (d.sinal >= d.total * info.get('sinalPct', 100) / 100 - 0.01 && d.sinal <= d.total);
    }
    // Pré-reserva nova: valores conferidos com os preços publicados pelo dono (o cliente não altera preço nem sinal)
    function precosOk(d) {
      let info = infoPublica();
      return info.get('preReserva', true) == true
        && d.valor == precoF(info, d)
        && (!ehMeia(d) || d.periodo == '24h')
        && (d.taxaLimpeza == 0 || d.taxaLimpeza == info.taxaLimpeza)
        && d.total == d.valor + d.taxaLimpeza
        && sinalOk(d, info)
        && d.expiraEm <= agora() + (info.get('prazoPagamentoMin', 30) + 2) * 60000;
    }
    // Horário exato + intervalo de limpeza com a locação anterior (dia "antes") e a seguinte (dia "depois")
    function horarioOk(d) {
      let folga = infoPublica().get('intervaloH', 0) * 3600000;
      let dia0 = diaTs(d.data);
      return d.ini == msDe(d.data, d.horaEntrada)
        && d.fim == d.ini + horasF(d) * 3600000
        && dataValida(d.antes) && diaTs(d.antes) == dia0 - duration.value(1, 'd')
        && dataValida(d.depois) && diaTs(d.depois) == dia0 + duration.value(contaF(d), 'd')
        && livreAntes(d.antes, d.ini, folga)
        && livreDepois(d.depois, d.fim, folga);
    }
    // Pedido de extensão de uma reserva CONFIRMADA do próprio cliente.
    // d.dias/periodo/meia = formato NOVO da reserva inteira; d.valor = diferença de preço de tabela.
    function extensaoOk(d) {
      let info = infoPublica();
      let r = reservaDoc(d.extensao);
      return info.get('preReserva', true) == true
        && r.get('clienteUid', '') == request.auth.uid
        && r.status == 'confirmada'
        && d.data == r.data && d.horaEntrada == r.horaEntrada
        && (!ehMeia(d) || d.periodo == '24h')
        && extensaoValores(d, r, info, msDe(r.data, r.horaEntrada), horasF(r), horasF(d));
    }
    function extensaoValores(d, r, info, iniR, hR, hD) {
      let dia0 = diaTs(r.data);
      return hD > hR
        && d.valor == precoF(info, d) - precoF(info, r)
        && d.taxaLimpeza == 0 && d.total == d.valor
        && sinalOk(d, info)
        && d.expiraEm <= agora() + (info.get('prazoPagamentoMin', 30) + 2) * 60000
        && d.ini == iniR + hR * 3600000                  // começa quando a reserva atual termina
        && d.fim == iniR + hD * 3600000
        && agora() <= d.ini                              // pedido feito antes do fim da estadia
        && dataValida(d.marcaIni) && diaTs(d.marcaIni) == dia0 + duration.value(contaF(r), 'd')
        && dataValida(d.depois) && diaTs(d.depois) == dia0 + duration.value(contaF(d), 'd')
        && livreDepois(d.depois, d.fim, info.get('intervaloH', 0) * 3600000);
    }
    match /solicitacoes/{id} {
      allow read: if isDono() || (logado() && resource.data.uid == request.auth.uid);
      allow delete: if isDono();
      // cliente: marcar "Já paguei" dentro do prazo, ou cancelar a própria pré-reserva enquanto aguarda
      allow update: if isDono() || (
        clienteAtivo()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'aguardando'
        && (
          (agora() <= resource.data.expiraEm
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pagoInformadoEm']))
          // cancelar só antes de informar o pagamento (depois disso as datas ficam presas até o dono decidir)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelada'
            && resource.data.get('pagoInformadoEm', null) == null)
        )
      );
      allow create: if isDono() || (
        clienteAtivo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'aguardando'
        && request.resource.data.keys().hasOnly(['uid','email','cliente','telefone','data','dias','periodo','horaEntrada','evento','obs','valor','taxaLimpeza','total','sinal','codigo','status','criadoEm','expiraEm','aceitouRegras','clienteCpf','clienteEndereco','aceiteContrato','meia','ini','fim','antes','depois','extensao','marcaIni'])
        // uma pré-reserva aguardando pagamento por vez (a marca é gravada no mesmo lote)
        && getAfter(/databases/$(database)/documents/preReservaAtiva/$(request.auth.uid)).data.sol == id
        && request.resource.data.cliente is string && request.resource.data.cliente.size() >= 3 && request.resource.data.cliente.size() <= 80
        && request.resource.data.telefone is string && request.resource.data.telefone.matches('^[0-9]{11}$')
        && dataValida(request.resource.data.data)
        && request.resource.data.ini is int && request.resource.data.fim is int
        && ('extensao' in request.resource.data
              ? (request.resource.data.extensao is string && extensaoOk(request.resource.data))
              : (diaTs(request.resource.data.data) >= request.time - duration.value(1, 'd')
                 && precosOk(request.resource.data) && horarioOk(request.resource.data)))
        && request.resource.data.periodo in ['12h', '24h']
        && (!('dias' in request.resource.data) || (request.resource.data.dias is int && request.resource.data.dias >= 1 && request.resource.data.dias <= 30))
        && request.resource.data.horaEntrada is string && request.resource.data.horaEntrada.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.evento is string && request.resource.data.evento.size() <= 60
        && request.resource.data.obs is string && request.resource.data.obs.size() <= 400
        && request.resource.data.codigo is string && request.resource.data.codigo.size() <= 12
        && request.resource.data.valor is number && request.resource.data.total is number && request.resource.data.sinal is number && request.resource.data.taxaLimpeza is number
        && request.resource.data.expiraEm is int
        && (!('clienteCpf' in request.resource.data) || (request.resource.data.clienteCpf is string && request.resource.data.clienteCpf.matches('^[0-9]{11}$')))
        && (!('clienteEndereco' in request.resource.data) || (request.resource.data.clienteEndereco is string && request.resource.data.clienteEndereco.size() <= 200))
      );
    }
  }
}
